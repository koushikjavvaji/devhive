# Optional: adds a single "gpt" teammate backed by real OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEAMMATE_NAME=gpt

# Optional: any number of OpenAI-compatible providers (same API shape, different
# base_url) — this is how you get more than one real LLM arguing in the same room.
# Free/cheap options: DeepSeek, Groq (generous free tier), OpenRouter (has free
# models), Together. A JSON list, one object per teammate:
#
# DEVHIVE_LLM_PROVIDERS=[{"name":"deepseek","base_url":"https://api.deepseek.com","api_key":"...","model":"deepseek-chat"},{"name":"groq-llama","base_url":"https://api.groq.com/openai/v1","api_key":"...","model":"llama-3.3-70b-versatile"}]
#
# Without any of the above, the room still works with triage-bot and (if a
# checkpoint exists) from-scratch-gpt.

# Optional: store rooms in Postgres instead of the local SQLite file (DEVHIVE_DB_PATH).
# Needed on hosts with an ephemeral disk, like Render's free tier. Free options: Neon, Supabase.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional overrides — defaults shown
# DEVHIVE_DB_PATH=data/devhive.db
# DEVHIVE_CHECKPOINT_PATH=checkpoints/ckpt.pt
# DEVHIVE_TOKENIZER_PATH=tokenizer/vocab.json

# Abuse/cost limits for a public deploy — defaults shown (see README "limits")
# DEVHIVE_MAX_MESSAGE_CHARS=8000
# DEVHIVE_MESSAGES_PER_IP=10
# DEVHIVE_MESSAGES_WINDOW_SECONDS=300
# DEVHIVE_ROOMS_PER_IP_PER_HOUR=20
# DEVHIVE_DAILY_MESSAGE_LIMIT=500
# DEVHIVE_LLM_TIMEOUT=45
# DEVHIVE_TRUSTED_PROXY_HOPS=1
